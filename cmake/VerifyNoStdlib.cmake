find_program(READELF readelf REQUIRED)
find_program(NM nm REQUIRED)
find_program(LDD ldd REQUIRED)
foreach(file IN ITEMS "${ARTIFACT}" "${LIBRARY}")
  if(file MATCHES "\\.a$")
    continue() # The executable below proves resolution of the static archive.
  endif()
  execute_process(COMMAND "${READELF}" -d "${file}" OUTPUT_VARIABLE deps COMMAND_ERROR_IS_FATAL ANY)
  if(deps MATCHES "NEEDED[^\n]*(libstdc\\+\\+|libc\\+\\+|libsupc\\+\\+|libc\\+\\+abi|libabsl)")
    message(FATAL_ERROR "Forbidden dependency in ${file}:\n${deps}")
  endif()
  execute_process(COMMAND "${LDD}" "${file}" OUTPUT_VARIABLE closure COMMAND_ERROR_IS_FATAL ANY)
  if(closure MATCHES "libstdc\\+\\+|libc\\+\\+|libsupc\\+\\+|libabsl")
    message(FATAL_ERROR "Forbidden transitive dependency in ${file}:\n${closure}")
  endif()
  execute_process(COMMAND "${NM}" -D -u -C "${file}" OUTPUT_VARIABLE symbols COMMAND_ERROR_IS_FATAL ANY)
  if(symbols MATCHES " U (std::|absl::|operator new|operator delete|__cxa_throw|__gxx_personality)")
    message(FATAL_ERROR "Unresolved C++ runtime symbol in ${file}:\n${symbols}")
  endif()
endforeach()
